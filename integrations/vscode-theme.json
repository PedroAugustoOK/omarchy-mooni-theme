{
  "$schema": "vscode://schemas/color-theme",
  "name": "Omarchy Mooni",
  "type": "light",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "parameter": "#1F667D",
    "property": "#1F667D",
    "variable": "#302713",
    "function": "#185A8A",
    "method": "#185A8A",
    "class": "#7A5000",
    "interface": "#7A5000",
    "enum": "#7A5000",
    "type": "#7A5000",
    "typeParameter": "#7A5000",
    "string": "#3F713A",
    "number": "#9B4B12",
    "boolean": "#9B4B12",
    "operator": "#176C68",
    "keyword": "#8A5A00",
    "macro": "#176C68",
    "decorator": "#185A8A",
    "comment": {
      "foreground": "#756448",
      "fontStyle": "italic"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#756448",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#3F713A"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#9B4B12"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#8A5A00"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#185A8A"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#7A5000"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator"
      ],
      "settings": {
        "foreground": "#176C68"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#302713"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#185A8A"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#665A3E"
      }
    }
  ],
  "colors": {
    "editor.foreground": "#302713",
    "editor.background": "#FFF9E8",
    "editorLineNumber.foreground": "#665A3E",
    "editorLineNumber.activeForeground": "#8A5A00",
    "editorCursor.foreground": "#8A5A00",
    "editor.lineHighlightBackground": "#F6EAC880",
    "editor.selectionBackground": "#F7E5AB80",
    "activityBar.background": "#F6EAC8",
    "activityBar.foreground": "#302713",
    "activityBar.activeBorder": "#8A5A00",
    "sideBar.background": "#F6EAC8",
    "sideBar.foreground": "#302713",
    "sideBar.border": "#E9D9AB",
    "tab.activeBackground": "#FFF9E8",
    "tab.inactiveBackground": "#F6EAC8",
    "statusBar.background": "#8A5A00",
    "statusBar.foreground": "#FFF9E8",
    "titleBar.activeBackground": "#FFF9E8",
    "titleBar.activeForeground": "#302713",
    "editorError.foreground": "#A3434E",
    "editorWarning.foreground": "#8A5A00",
    "editorInfo.foreground": "#185A8A",
    "focusBorder": "#8A5A00"
  }
}
