{
  "$schema": "vscode://schemas/color-theme",
  "name": "Omarchy Mooni",
  "type": "light",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "parameter": "#1F667D",
    "property": "#1F667D",
    "variable": "#302713",
    "function": "#185A8A",
    "method": "#185A8A",
    "class": "#7A5000",
    "interface": "#7A5000",
    "enum": "#7A5000",
    "type": "#7A5000",
    "typeParameter": "#7A5000",
    "string": "#3F713A",
    "number": "#9B4B12",
    "boolean": "#8E4B0A",
    "enumMember": "#8E4B0A",
    "variable.readonly": "#8E4B0A",
    "operator": "#176C68",
    "keyword": "#8A5A00",
    "macro": "#176C68",
    "decorator": "#185A8A",
    "comment": {
      "foreground": "#756448",
      "fontStyle": "italic"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#756448",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#3F713A"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.character"
      ],
      "settings": {
        "foreground": "#9B4B12"
      }
    },
    {
      "scope": [
        "constant.language",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#8E4B0A"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#8A5A00"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#185A8A"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#7A5000"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator"
      ],
      "settings": {
        "foreground": "#176C68"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#302713"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#1F667D"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#185A8A"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#816E4D"
      }
    }
  ],
  "colors": {
    "editor.foreground": "#302713",
    "editor.background": "#FFF9E8",
    "editorLineNumber.foreground": "#665A3E",
    "editorLineNumber.activeForeground": "#8A5A00",
    "editorCursor.foreground": "#8A5A00",
    "editor.lineHighlightBackground": "#F6EAC880",
    "editor.selectionBackground": "#F7E5AB",
    "activityBar.background": "#F6EAC8",
    "activityBar.foreground": "#302713",
    "activityBar.activeBorder": "#8A5A00",
    "sideBar.background": "#F6EAC8",
    "sideBar.foreground": "#302713",
    "sideBar.border": "#E9D9AB",
    "tab.activeBackground": "#FFF9E8",
    "tab.inactiveBackground": "#F6EAC8",
    "statusBar.background": "#8A5A00",
    "statusBar.foreground": "#FFF9E8",
    "titleBar.activeBackground": "#FFF9E8",
    "titleBar.activeForeground": "#302713",
    "editorError.foreground": "#A3434E",
    "editorWarning.foreground": "#8A5A00",
    "editorInfo.foreground": "#185A8A",
    "focusBorder": "#8A5A00",
    "foreground": "#302713",
    "descriptionForeground": "#665A3E",
    "disabledForeground": "#665A3E",
    "errorForeground": "#A3434E",
    "editor.selectionForeground": "#302713",
    "editor.inactiveSelectionBackground": "#F7E5AB",
    "list.activeSelectionBackground": "#F7E5AB",
    "list.activeSelectionForeground": "#302713",
    "list.inactiveSelectionBackground": "#F7E5AB",
    "list.inactiveSelectionForeground": "#302713",
    "list.focusBackground": "#F7E5AB",
    "list.focusForeground": "#302713",
    "list.hoverBackground": "#F6EAC8",
    "list.hoverForeground": "#302713",
    "list.highlightForeground": "#8A5A00",
    "activityBar.inactiveForeground": "#665A3E",
    "editorGroupHeader.tabsBackground": "#F6EAC8",
    "tab.activeForeground": "#302713",
    "tab.inactiveForeground": "#665A3E",
    "tab.activeBorderTop": "#8A5A00",
    "tab.border": "#F6EAC8",
    "titleBar.inactiveBackground": "#F6EAC8",
    "titleBar.inactiveForeground": "#665A3E",
    "panel.background": "#FFF9E8",
    "panel.border": "#E9D9AB",
    "panelTitle.activeForeground": "#302713",
    "panelTitle.inactiveForeground": "#665A3E",
    "panelTitle.activeBorder": "#8A5A00",
    "input.background": "#FFF9E8",
    "input.foreground": "#302713",
    "input.border": "#665A3E",
    "input.placeholderForeground": "#665A3E",
    "dropdown.background": "#F6EAC8",
    "dropdown.foreground": "#302713",
    "dropdown.border": "#665A3E",
    "button.background": "#8A5A00",
    "button.foreground": "#FFF9E8",
    "badge.background": "#8A5A00",
    "badge.foreground": "#FFF9E8",
    "statusBar.noFolderBackground": "#8A5A00",
    "statusBar.noFolderForeground": "#FFF9E8",
    "statusBar.debuggingBackground": "#8A5A00",
    "statusBar.debuggingForeground": "#FFF9E8",
    "editorWidget.background": "#F6EAC8",
    "editorWidget.foreground": "#302713",
    "editorWidget.border": "#665A3E",
    "editorSuggestWidget.background": "#F6EAC8",
    "editorSuggestWidget.foreground": "#302713",
    "editorSuggestWidget.selectedBackground": "#F7E5AB",
    "editorSuggestWidget.selectedForeground": "#302713",
    "editorSuggestWidget.highlightForeground": "#8A5A00",
    "menu.background": "#F6EAC8",
    "menu.foreground": "#302713",
    "menu.selectionBackground": "#F7E5AB",
    "menu.selectionForeground": "#302713",
    "notifications.background": "#F6EAC8",
    "notifications.foreground": "#302713",
    "terminal.background": "#FFF9E8",
    "terminal.foreground": "#302713",
    "editorBracketHighlight.foreground1": "#185A8A",
    "editorBracketHighlight.foreground2": "#7A5000",
    "editorBracketHighlight.foreground3": "#1F667D",
    "editorBracketHighlight.foreground4": "#8A5A00",
    "editorBracketHighlight.foreground5": "#3F713A",
    "editorBracketHighlight.foreground6": "#9B4B12",
    "terminal.ansiBlack": "#FFF9E8",
    "terminal.ansiRed": "#AF5860",
    "terminal.ansiGreen": "#3F713A",
    "terminal.ansiYellow": "#7A5000",
    "terminal.ansiBlue": "#185A8A",
    "terminal.ansiMagenta": "#80608D",
    "terminal.ansiCyan": "#176C68",
    "terminal.ansiWhite": "#7D6D48",
    "terminal.ansiBrightBlack": "#665A3E",
    "terminal.ansiBrightRed": "#C86F76",
    "terminal.ansiBrightGreen": "#71915F",
    "terminal.ansiBrightYellow": "#C58B18",
    "terminal.ansiBrightBlue": "#5B86A9",
    "terminal.ansiBrightMagenta": "#9975A7",
    "terminal.ansiBrightCyan": "#5D9692",
    "terminal.ansiBrightWhite": "#1E180B",
    "editorHint.foreground": "#176C68"
  }
}
